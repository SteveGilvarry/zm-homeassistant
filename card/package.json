{
  "name": "zoneminder-card",
  "version": "0.2.0",
  "private": true,
  "description": "Lovelace card for the ZoneMinder integration: live cameras with a day of recordings under each",
  "main": "dist/zoneminder-card.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveGilvarry/zm-homeassistant",
    "directory": "card"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "zoneminder"
  ],
  "author": "Steve Gilvarry",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "ship": "npm run build && cp dist/zoneminder-card.js ../custom_components/zoneminder/www/zoneminder-card.js"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "rollup": "^4.9.6",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^2.0.3",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
